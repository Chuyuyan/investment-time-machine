{
  "_readme": "Capture-the-Why taxonomy. Architecture: a reusable Motivation Library (atomic, each with a 7-trait fingerprint) + Context Menus that re-skin 4 motivations per situation. Runtime: on each 'why' tap, add motivation.traits to the running dnaVector; archetype = nearest prototype (min Euclidean distance) in archetypes[]. Traits: FOMO is a vulnerability (high = worse); the other six are virtues. Conviction is ambiguous alone - Conviction + Research + Calibration = earned; Conviction - Research - Calibration = blind. Trait scale: -2..+2. Forward-compatible: when free-text 'why' capture is added later, an LLM classifies text into the nearest motivation id and all downstream systems keep working.",
  "traits": [
    { "id": "fomo", "label": "FOMO", "polarity": "vulnerability", "meaning": "Decisions driven by missing out / herd. High is worse." },
    { "id": "discipline", "label": "Discipline", "polarity": "virtue", "meaning": "Acting on plan, overriding impulse." },
    { "id": "patience", "label": "Patience", "polarity": "virtue", "meaning": "Tolerating inaction / long horizon." },
    { "id": "conviction", "label": "Conviction", "polarity": "ambiguous", "meaning": "Strength of independent belief; earned only with research + calibration." },
    { "id": "research", "label": "Research", "polarity": "virtue", "meaning": "Grounded in information vs emotion/social cues." },
    { "id": "riskAwareness", "label": "Risk Awareness", "polarity": "virtue", "meaning": "Weighs downside, sizing, what-could-go-wrong." },
    { "id": "calibration", "label": "Calibration", "polarity": "virtue", "meaning": "Stated certainty matches reality; updates on evidence." }
  ],
  "families": [
    { "id": "social", "label": "Social / Herd", "valence": "vulnerability", "biasLine": "That has a name: herd instinct. The crowd is the most expensive voice in investing." },
    { "id": "fear", "label": "Fear / Pain-avoidance", "valence": "vulnerability", "biasLine": "That feeling has a name: panic. It's the tax fear charges on every portfolio." },
    { "id": "greed", "label": "Greed / Overconfidence", "valence": "vulnerability", "biasLine": "That has a name: overconfidence. It feels like edge. It's usually just exposure." },
    { "id": "plan", "label": "Plan / Discipline", "valence": "virtue", "biasLine": "That's discipline - boring on the day, decisive over a decade." },
    { "id": "research", "label": "Evidence / Research", "valence": "virtue", "biasLine": "That's process. You reasoned instead of reacted." },
    { "id": "conviction", "label": "Patience / Conviction", "valence": "virtue", "biasLine": "That's conviction with patience - the rare kind that survives a bad week." },
    { "id": "humility", "label": "Humility / Risk", "valence": "virtue", "biasLine": "That's risk awareness. You respected what you couldn't know." }
  ],
  "motivations": [
    { "id": "plan_fit", "text": "It fits my plan and I sized it sensibly", "family": "plan", "archetype": "steady_hand", "traits": { "fomo": -1, "discipline": 2, "patience": 1, "conviction": 0, "research": 1, "riskAwareness": 2, "calibration": 1 } },
    { "id": "rebalance_dca", "text": "I'm rebalancing / averaging in on schedule", "family": "plan", "archetype": "steady_hand", "traits": { "fomo": -1, "discipline": 2, "patience": 1, "conviction": 0, "research": 1, "riskAwareness": 2, "calibration": 1 } },
    { "id": "take_profits", "text": "I took some profits / trimmed concentration", "family": "plan", "archetype": "steady_hand", "traits": { "fomo": -1, "discipline": 2, "patience": 1, "conviction": 0, "research": 0, "riskAwareness": 2, "calibration": 1 } },
    { "id": "size_to_risk", "text": "I sized to my risk - no chasing", "family": "humility", "archetype": "steady_hand", "traits": { "fomo": -2, "discipline": 2, "patience": 1, "conviction": 0, "research": 1, "riskAwareness": 2, "calibration": 1 } },
    { "id": "cash_ready", "text": "I had cash ready and bought to plan", "family": "humility", "archetype": "tactician", "traits": { "fomo": -1, "discipline": 2, "patience": 2, "conviction": 1, "research": 1, "riskAwareness": 2, "calibration": 2 } },
    { "id": "afford_to_lose", "text": "I'm only risking what I can afford to lose", "family": "humility", "archetype": "tactician", "traits": { "fomo": -1, "discipline": 1, "patience": 1, "conviction": 0, "research": 0, "riskAwareness": 2, "calibration": 2 } },
    { "id": "dont_understand", "text": "I don't understand it well enough yet, so I wait", "family": "humility", "archetype": "tactician", "traits": { "fomo": -1, "discipline": 1, "patience": 1, "conviction": 0, "research": 1, "riskAwareness": 1, "calibration": 2 } },
    { "id": "research_thesis", "text": "I researched it and believe in the long-term case", "family": "research", "archetype": "researcher", "traits": { "fomo": -1, "discipline": 1, "patience": 1, "conviction": 2, "research": 2, "riskAwareness": 0, "calibration": 1 } },
